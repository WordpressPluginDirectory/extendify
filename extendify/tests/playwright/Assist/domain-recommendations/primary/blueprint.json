{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"login": false,
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"EXTENDIFY_PARTNER_ID": "github"
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "extendable"
			},
			"options": { "activate": true }
		},
		{
			"step": "setSiteOptions",
			"options": {
				"extendify_partner_data_v2": {
					"deactivated": false,
					"showDomainBanner": true,
					"showDomainTask": true,
					"showSecondaryDomainBanner": false,
					"showSecondaryDomainTask": false,
					"stagingSites": ["127.0.0.1"],
					"domainSearchURL": "https://example.com?s={DOMAIN}"
				},
				"_transient_extendify_partner_data_cache_check": "1",
				"_transient_extendify_domains": [
					"google.com",
					"facebook.com",
					"twitter.com",
					"linkedin.com"
				],
				"_transient_extendify_recommendations": [],
				"_transient_extendify_supportArticles": []
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-content/plugins/extendify-sdk/tests/playwright/setup.php'; ?>"
		}
	]
}
